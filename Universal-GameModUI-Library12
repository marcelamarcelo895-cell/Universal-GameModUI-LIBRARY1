function GameModMenu:updateRobloxMenuItems()
	for _, item in pairs(self.menuContainer:GetChildren()) do
		if item:IsA("TextButton") then
			item:Destroy()
		end
	end
	
	local items = MENU_DATA[self.activeTab].items
	for _, itemData in pairs(items) do
		local menuItem = Instance.new("TextButton")
		menuItem.Name = itemData.name
		menuItem.Size = UDim2.new(1, 0, 1, 0)
		menuItem.BackgroundColor3 = Color3.fromRGB(unpack(COLORS.Dark))
		menuItem.TextColor3 = Color3.fromRGB(unpack(COLORS.Text))
		menuItem.TextSize = 11
		menuItem.Font = Enum.Font.GothamSemibold
		menuItem.Text = (itemData.icon or "•") .. " " .. itemData.name
		menuItem.TextTruncate = Enum.TextTruncate.AtEnd
		menuItem.BorderSizePixel = 0
		menuItem.Parent = self.menuContainer
		
		local miCorner = Instance.new("UICorner")
		miCorner.CornerRadius = UDim.new(0, 8)
		miCorner.Parent = menuItem
		
		local miStroke = Instance.new("UIStroke")
		miStroke.Color = Color3.fromRGB(unpack(COLORS.Border))
		miStroke.Thickness = 1
		miStroke.Parent = menuItem
		
		menuItem.MouseEnter:Connect(function()
			menuItem.BackgroundColor3 = Color3.fromRGB(unpack(COLORS[self.activeTab].primary))
			miStroke.Thickness = 2
		end)
		
		menuItem.MouseLeave:Connect(function()
			menuItem.BackgroundColor3 = Color3.fromRGB(unpack(COLORS.Dark))
			miStroke.Thickness = 1
		end)
		
		menuItem.MouseButton1Click:Connect(function()
			self:toggleRobloxDropdown(itemData.name, menuItem)
		end)
	end
end

function GameModMenu:toggleRobloxDropdown(itemName, sourceButton)
	if self.expandedItems[itemName] then
		self:closeRobloxDropdown(itemName)
	else
		self:closeAllRobloxDropdowns()
		self:openRobloxDropdown(itemName, sourceButton)
	end
end

