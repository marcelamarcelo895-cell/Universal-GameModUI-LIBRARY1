function GameModMenu:initGeneric()
	-- For generic Lua, Delta, Potassium, Medium executors
	self.uiState = {
		menuOpen = true,
		selectedTab = self.activeTab,
		selectedItems = {},
	}
	
	self:renderGenericUI()
end

function GameModMenu:renderGenericUI()
	-- Create console-based or generic output UI
	local output = "╔" .. string.rep("═", 118) .. "╗\n"
	output = output .. "║" .. string.rep(" ", 40) .. "GAME MOD MENU v2.0" .. string.rep(" ", 61) .. "║\n"
	output = output .. "╠" .. string.rep("═", 118) .. "╣\n"
	
	-- Tab selection
	output = output .. "║ TAB SELECTION: "
	local tabs = {"Combat", "Blatant", "Utility", "World", "Other"}
	for idx, tab in pairs(tabs) do
		if tab == self.activeTab then
			output = output .. "[✓ " .. tab .. "] "
		else
			output = output .. "[" .. idx .. "] " .. tab .. " "
		end
	end
	output = output .. string.rep(" ", 118 - string.len("TAB SELECTION: [✓ " .. self.activeTab .. "]")) .. "║\n"
	output = output .. "╠" .. string.rep("═", 118) .. "╣\n"
	
	-- Menu items
	local items = MENU_DATA[self.activeTab].items
	output = output .. "║ MENU ITEMS (" .. self.activeTab .. " - " .. #items .. " items):" .. string.rep(" ", 118 - (#self.activeTab + 20)) .. "║\n"
	output = output .. "╠" .. string.rep("═", 118) .. "╣\n"
	
	for idx, itemData in pairs(items) do
		local isExpanded = self.expandedItems[itemData.name] or false
		local expandIcon = isExpanded and "▼" or "▶"
		local itemStr = "║ " .. expandIcon .. " [" .. string.format("%2d", idx) .. "] " .. itemData.icon .. " " .. itemData.name
		output = output .. itemStr .. string.rep(" ", 118 - string.len(itemStr)) .. "║\n"
		
		if isExpanded then
			local options = {"Toggle", "Enable", "Disable", "Reset", "Settings"}
			for _, opt in pairs(options) do
				local optStr = "║    └─ " .. opt
				output = output .. optStr .. string.rep(" ", 118 - string.len(optStr)) .. "║\n"
			end
		end
	end
	
	output = output .. "╠" .. string.rep("═", 118) .. "╣\n"
	output = output .. "║ DISCORD PANEL:" .. string.rep(" ", 103) .. "║\n"
	output = output .. "║ 🎮 DerrickNewton84 | SynC" .. string.rep(" ", 90) .. "║\n"
	output = output .. "║ 3:35 • Reenviado  [😊 React]" .. string.rep(" ", 87) .. "║\n"
	output = output .. "╚" .. string.rep("═", 118) .. "╝\n"
	
	print(output)
	
	-- Store UI state
	self.genericUI = output
end

function GameModMenu:switchTabGeneric(tabName)
	if MENU_DATA[tabName] then
		self.activeTab = tabName
		self.expandedItems = {}
		self:renderGenericUI()
		return true
	end
	return false
end

function GameModMenu:toggleItemGeneric(itemName)
	self.expandedItems[itemName] = not self.expandedItems[itemName]
	self:renderGenericUI()
end

-- ============================================================================
-- PUBLIC API - UNIVERSAL ACROSS PLATFORMS
-- ============================================================================

function GameModMenu:getActiveTab()
	return self.activeTab
end

function GameModMenu:setActiveTab(tabName)
	if MENU_DATA[tabName] then
		if self.executor == "roblox" then
			self:switchTab(tabName)
		else
			self:switchTabGeneric(tabName)
		end
		return true
	end
	return false
end

function GameModMenu:getExpandedItems()
	local expanded = {}
	for item, state in pairs(self.expandedItems) do
		if state then
			table.insert(expanded, item)
		end
	end
	return expanded
end

function GameModMenu:isItemExpanded(itemName)
	return self.expandedItems[itemName] or false
end

function GameModMenu:getMenuItems(tab)
	tab = tab or self.activeTab
	if MENU_DATA[tab] then
		return MENU_DATA[tab].items
	end
	return {}
end

function GameModMenu:toggleItem(itemName)
	if self.executor == "roblox" then
		self:toggleRobloxDropdown(itemName, self.menuContainer:FindFirstChild(itemName))
	else
		self:toggleItemGeneric(itemName)
	end
end

function GameModMenu:getExecutor()
	return self.executor
end

function GameModMenu:printDebugInfo()
	local info = string.format(
		"[DEBUG] Executor: %s | Tab: %s | Expanded: %d | Menu Items: %d",
		self.executor,
		self.activeTab,
		#self:getExpandedItems(),
		#self:getMenuItems()
	)
	print(info)
	return info
end

function GameModMenu:destroy()
	if self.executor == "roblox" and self.gui then
		self.gui:Destroy()
	end
	self.expandedItems = {}
	self.dropdowns = {}
	print("[GameModMenu] Destroyed successfully")
end

-- ============================================================================
-- INITIALIZATION & EXPORT
-- ============================================================================

return GameModMenu

