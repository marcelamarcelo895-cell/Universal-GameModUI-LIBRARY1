-- Color converter function
local function rgbToHex(r, g, b)
	return string.format("#%02X%02X%02X", r, g, b)
end

-- Hex to RGB converter
local function hexToRgb(hex)
	hex = hex:gsub("#", "")
	return tonumber("0x" .. hex:sub(1, 2)), tonumber("0x" .. hex:sub(3, 4)), tonumber("0x" .. hex:sub(5, 6))
end

-- Deep table copy
local function tableCopy(tbl)
	local copy = {}
	for k, v in pairs(tbl) do
		if type(v) == "table" then
			copy[k] = tableCopy(v)
		else
			copy[k] = v
		end
	end
	return copy
end

-- Table merge
local function tableMerge(base, override)
	for k, v in pairs(override) do
		if type(v) == "table" and type(base[k]) == "table" then
			tableMerge(base[k], v)
		else
			base[k] = v
		end
	end
	return base
end

-- ============================================================================
-- UI ELEMENT DEFINITIONS
-- ============================================================================

local UIElement = {}
UIElement.__index = UIElement

function UIElement.new(elementType, properties)
	local self = setmetatable({}, UIElement)
	self.type = elementType
	self.properties = properties or {}
	self.children = {}
	self.callbacks = {}
	self.state = {
		hovered = false,
		active = false,
		visible = true,
		enabled = true,
	}
	return self
end

function UIElement:setProperty(key, value)
	self.properties[key] = value
	return self
end

function UIElement:getProperty(key)
	return self.properties[key]
end

function UIElement:addChild(element)
	table.insert(self.children, element)
	return self
end

function UIElement:onHover(callback)
	self.callbacks.hover = callback
	return self
end

function UIElement:onClick(callback)
	self.callbacks.click = callback
	return self
end

function UIElement:setText(text)
	self.properties.text = text
	return self
end

function UIElement:setColor(colorTable)
	self.properties.color = colorTable
	return self
end

function UIElement:toString()
	local props = {}
	for k, v in pairs(self.properties) do
		if type(v) == "table" then
			props[k] = "{"..table.concat(v, ", ").."}"
		else
			props[k] = tostring(v)
		end
	end
	
	local propsStr = ""
	for k, v in pairs(props) do
		propsStr = propsStr .. k .. "=" .. v .. "; "
	end
	
	return string.format("<%s: %s>", self.type, propsStr)
end

