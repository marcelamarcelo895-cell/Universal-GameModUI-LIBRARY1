function GameModMenu.new(options)
	local self = setmetatable({}, GameModMenu)
	
	options = options or {}
	self.config = tableMerge(tableCopy(CONFIG), options.config or {})
	self.executor = EXECUTOR.TYPE
	
	self.activeTab = "Combat"
	self.expandedItems = {}
	self.menuState = {}
	self.uiElements = {}
	self.dropdowns = {}
	
	-- Platform-specific initialization
	if self.executor == "roblox" then
		self:initRoblox()
	elseif self.executor == "generic" or self.executor == "delta" or self.executor == "potassium" or self.executor == "medium" then
		self:initGeneric()
	end
	
	return self
end

