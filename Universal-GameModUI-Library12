	local rbStroke = Instance.new("UIStroke")
	rbStroke.Color = Color3.fromRGB(unpack(COLORS.Border))
	rbStroke.Thickness = 1
	rbStroke.Parent = reactionBtn
	
	reactionBtn.MouseEnter:Connect(function()
		reactionBtn.BackgroundColor3 = Color3.fromRGB(unpack(COLORS.Border))
	end)
	
	reactionBtn.MouseLeave:Connect(function()
		reactionBtn.BackgroundColor3 = Color3.fromRGB(unpack(COLORS.Darker))
	end)
	
	reactionBtn.MouseButton1Click:Connect(function()
		print("Reaction clicked")
	end)
end

function GameModMenu:switchTab(tabName)
	if self.activeTab == tabName then return end
	self.activeTab = tabName
	
	-- Update tab buttons
	for name, btn in pairs(self.uiElements) do
		if string.find(name, "_tab") then
			local btnTabName = string.gsub(name, "_tab", "")
			btn.BackgroundColor3 = btnTabName == tabName and Color3.fromRGB(unpack(COLORS[btnTabName].primary)) or Color3.fromRGB(unpack(COLORS.Dark))
			
			local stroke = btn:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = btnTabName == tabName and Color3.fromRGB(unpack(COLORS[btnTabName].primary)) or Color3.fromRGB(unpack(COLORS.Border))
			end
		end
	end
	
	self:updateRobloxMenuItems()
	self:closeAllRobloxDropdowns()
end

