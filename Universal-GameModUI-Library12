function GameModMenu:closeRobloxDropdown(itemName)
	if self.dropdowns[itemName] then
		self.dropdowns[itemName]:Destroy()
		self.dropdowns[itemName] = nil
	end
	self.expandedItems[itemName] = false
end

function GameModMenu:closeAllRobloxDropdowns()
	for itemName, dropdown in pairs(self.dropdowns) do
		if dropdown and dropdown.Parent then
			dropdown:Destroy()
		end
		self.expandedItems[itemName] = false
	end
	self.dropdowns = {}
end

